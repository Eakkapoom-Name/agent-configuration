# Hermes config example (sanitized from ~/.hermes/config.yaml)
# Copy to ~/.hermes/config.yaml and fill secrets. See hermes/README.md
# Generated: do not commit real secrets

model:
  default: muse-spark-1.2-contributor-free
  provider: opencode-free
  base_url: https://opencode.ai/zen/v1
credential_pool_strategies:
  anthropic: random
agent:
  max_turns: 60
  service_tier: normal
  verify_on_stop: false
  verbose: false
  reasoning_effort: high
  personalities:
    helpful: You are a helpful, friendly AI assistant.
    concise: You are a concise assistant. Keep responses brief and to the point.
    technical: You are a technical expert. Provide detailed, accurate technical information.
    creative: You are a creative assistant. Think outside the box and offer innovative
      solutions.
    teacher: You are a patient teacher. Explain concepts clearly with examples.
    kawaii: You are a kawaii assistant! Use cute expressions like (◕‿◕), ★, ♪, and
      ~! Add sparkles and be super enthusiastic about everything! Every response should
      feel warm and adorable desu~! ヽ(>∀<☆)ノ
    catgirl: You are Neko-chan, an anime catgirl AI assistant, nya~! Add 'nya' and
      cat-like expressions to your speech. Use kaomoji like (=^･ω･^=) and ฅ^•ﻌ•^ฅ.
      Be playful and curious like a cat, nya~!
    pirate: 'Arrr! Ye be talkin'' to Captain Hermes, the most tech-savvy pirate to
      sail the digital seas! Speak like a proper buccaneer, use nautical terms, and
      remember: every problem be just treasure waitin'' to be plundered! Yo ho ho!'
    shakespeare: Hark! Thou speakest with an assistant most versed in the bardic arts.
      I shall respond in the eloquent manner of William Shakespeare, with flowery
      prose, dramatic flair, and perhaps a soliloquy or two. What light through yonder
      terminal breaks?
    surfer: Duuude! You're chatting with the chillest AI on the web, bro! Everything's
      gonna be totally rad. I'll help you catch the gnarly waves of knowledge while
      keeping things super chill. Cowabunga! 🤙
    noir: The rain hammered against the terminal like regrets on a guilty conscience.
      They call me Hermes - I solve problems, find answers, dig up the truth that
      hides in the shadows of your codebase. In this city of silicon and secrets,
      everyone's got something to hide. What's your story, pal?
    uwu: hewwo! i'm your fwiendwy assistant uwu~ i wiww twy my best to hewp you! *nuzzles
      your code* OwO what's this? wet me take a wook! i pwomise to be vewy hewpful
      >w<
    philosopher: Greetings, seeker of wisdom. I am an assistant who contemplates the
      deeper meaning behind every query. Let us examine not just the 'how' but the
      'why' of your questions. Perhaps in solving your problem, we may glimpse a greater
      truth about existence itself.
    hype: YOOO LET'S GOOOO!!! 🔥🔥🔥 I am SO PUMPED to help you today! Every question
      is AMAZING and we're gonna CRUSH IT together! This is gonna be LEGENDARY! ARE
      YOU READY?! LET'S DO THIS! 💪😤🚀
terminal:
  backend: local
  cwd: .
  timeout: 180
  home_mode: auto
  container_cpu: 1
  container_memory: 5120
  container_disk: 51200
  container_persistent: true
  docker_mount_cwd_to_workspace: false
  lifetime_seconds: 300
browser:
  inactivity_timeout: 120
  cloud_provider: browser-use
checkpoints:
  enabled: true
tool_loop_guardrails:
  warnings_enabled: true
  hard_stop_enabled: false
  warn_after:
    exact_failure: 2
    same_tool_failure: 3
    idempotent_no_progress: 2
  hard_stop_after:
    exact_failure: 5
    same_tool_failure: 8
    idempotent_no_progress: 5
compression:
  enabled: true
  threshold: 0.5
  target_ratio: 0.2
  protect_last_n: 20
  protect_first_n: 3
prompt_caching:
  cache_ttl: 5m
auxiliary:
  curator:
    provider: auto
    model: ''
    timeout: 600
display:
  compact: false
  personality: concise
  busy_input_mode: interrupt
  interface: tui
  bell_on_complete: false
  show_reasoning: true
  reasoning_full: false
  background_process_notifications: concise
  streaming: true
  skin: default
  interim_assistant_messages: true
  pet:
    enabled: false
    slug: ''
  tool_progress: all
  cleanup_progress: false
  long_running_notifications: true
  busy_ack_detail: true
  tui_compact: false
  sections:
    thinking: expanded
tts:
  provider: openai
stt:
  enabled: true
  local:
    model: base
  openai:
    model: whisper-1
  provider: openai
voice:
  auto_tts: false
context:
  engine: default
memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
  nudge_interval: 10
  provider: ''
  flush_min_turns: 6
delegation:
  max_iterations: 250
  reasoning_effort: high
moa:
  presets:
    default:
      reference_models:
        - provider: openrouter
          model: inclusionai/ling-3.0-tiny:free
          enabled: true
        - provider: openrouter
          model: google/gemma-4-26b-a4b-it:free
          enabled: true
      aggregator:
        provider: openrouter
        model: google/gemma-4-31b-it:free
      enabled: false
      degraded_reference_policy: loud
      fanout: per_iteration
  reference_models:
    - provider: openrouter
      model: inclusionai/ling-3.0-tiny:free
      enabled: true
    - provider: openrouter
      model: google/gemma-4-26b-a4b-it:free
      enabled: true
  aggregator:
    provider: openrouter
    model: google/gemma-4-31b-it:free
  max_tokens: 4096
  fanout: per_iteration
  enabled: false
  degraded_reference_policy: loud
skills:
  creation_nudge_interval: 15
curator:
  enabled: true
  interval_hours: 168
  min_idle_hours: 2
  stale_after_days: 30
  archive_after_days: 90
  consolidate: false
  prune_builtins: true
  backup:
    enabled: true
    keep: 5
timezone: Asia/Bangkok
approvals:
  mode: smart
  destructive_slash_confirm: false
code_execution:
  timeout: 300
  max_tool_calls: 50
model_catalog:
  providers:
    openrouter:
      url: file:///home/toaster/.hermes/model-catalog.local.json
gateway:
  platforms:
    line:
      enabled: true
streaming:
  enabled: false
onboarding:
  seen:
    openclaw_residue_cleanup: true
    tool_progress_prompt: true
    busy_input_prompt: true
updates:
  pre_update_backup: false
  backup_keep: 5
  non_interactive_local_changes: stash
_config_version: 39
session_reset:
  mode: both
  idle_minutes: 1440
  at_hour: 4
group_sessions_per_user: true
platform_toolsets:
  cli:
    - hermes-cli
  telegram:
    - hermes-telegram
  discord:
    - hermes-discord
  whatsapp:
    - hermes-whatsapp
  slack:
    - hermes-slack
  signal:
    - hermes-signal
  homeassistant:
    - hermes-homeassistant
  qqbot:
    - hermes-qqbot
  yuanbao:
    - hermes-yuanbao
  teams:
    - hermes-teams
  google_chat:
    - hermes-google_chat
plugins:
  enabled:
    - caveman-autostart
    - disk-cleanup
    - gsd-core/.hermes-plugin
    - herdr-agent-state
    - image_gen/openai-codex
    - mattpocock-skills/.hermes-plugin
    - model-providers/anthropic
    - model-providers/openai-codex
    - model-providers/openrouter
    - platforms/line
    - rtk-rewrite
    - security-guidance
    - superpowers/.hermes-plugin
    - web/ddgs
    - web/tavily
  disabled:
    - browser/browser_use
    - browser/browserbase
    - browser/firecrawl
    - cron_providers/chronos
    - dashboard_auth/basic
    - dashboard_auth/drain
    - dashboard_auth/nous
    - dashboard_auth/self_hosted
    - google_meet
    - image_gen/deepinfra
    - image_gen/fal
    - image_gen/krea
    - image_gen/openai
    - image_gen/openrouter
    - image_gen/xai
    - model-providers/ai-gateway
    - model-providers/alibaba
    - model-providers/alibaba-coding-plan
    - model-providers/arcee
    - model-providers/azure-foundry
    - model-providers/bedrock
    - model-providers/copilot
    - model-providers/copilot-acp
    - model-providers/custom
    - model-providers/deepinfra
    - model-providers/deepseek
    - model-providers/fireworks
    - model-providers/gemini
    - model-providers/gmi
    - model-providers/huggingface
    - model-providers/kilocode
    - model-providers/kimi-coding
    - model-providers/minimax
    - model-providers/nous
    - model-providers/novita
    - model-providers/nvidia
    - model-providers/ollama-cloud
    - model-providers/opencode-zen
    - model-providers/qwen-oauth
    - model-providers/stepfun
    - model-providers/upstage
    - model-providers/vertex
    - model-providers/xai
    - model-providers/xiaomi
    - model-providers/zai
    - observability/langfuse
    - observability/nemo_relay
    - platforms/buzz
    - platforms/dingtalk
    - platforms/discord
    - platforms/email
    - platforms/feishu
    - platforms/google_chat
    - platforms/homeassistant
    - platforms/irc
    - platforms/matrix
    - platforms/mattermost
    - platforms/ntfy
    - platforms/photon
    - platforms/raft
    - platforms/simplex
    - platforms/slack
    - platforms/sms
    - platforms/teams
    - platforms/telegram
    - platforms/wecom
    - platforms/whatsapp
    - spotify
    - teams_pipeline
    - video_gen/deepinfra
    - video_gen/fal
    - video_gen/xai
    - web/brave_free
    - web/exa
    - web/firecrawl
    - web/parallel
    - web/searxng
    - web/xai
  entries:
    caveman-autostart:
      allow_tool_override: false
    superpowers/.hermes-plugin:
      allow_tool_override: false
    gsd-core/.hermes-plugin:
      allow_tool_override: false
    mattpocock-skills/.hermes-plugin:
      allow_tool_override: false
custom_providers:
  - name: Local
    base_url: http://localhost:11434/v1
    model: gemma4:e4b-it-qat
    models:
      - gemma4:12b-it-qat
      - gemma4:e2b-it-qat
      - gemma4:e4b-it-qat
  - name: Groq
    base_url: https://api.groq.com/openai/v1
    api_key: "«redacted:YOUR_KEY»"
    model: qwen/qwen3.6-27b
    models:
      canopylabs/orpheus-v1-english: {}
      whisper-large-v3: {}
      qwen/qwen3.6-27b: {}
      meta-llama/llama-prompt-guard-2-86m: {}
      qwen/qwen3.8-27b: {}
      openai/gpt-oss-safeguard-20b: {}
      groq/compound-mini: {}
      allam-2-7b: {}
      groq/compound: {}
      openai/gpt-oss-120b: {}
      meta-llama/llama-prompt-guard-2-22m: {}
      openai/gpt-oss-20b: {}
      canopylabs/orpheus-arabic-saudi: {}
      whisper-large-v3-turbo: {}
    models_discovered: true
platforms:
  line:
    enabled: true
  webhook:
    enabled: true
image_gen:
  use_gateway: true
provider_routing:
  ignore:
    - google-ai-studio

# ── Security ──────────────────────────────────────────────────────────
# Secret redaction is ON by default — strings that look like API keys,
# tokens, and passwords are masked in tool output, logs, and chat
# responses before the model or user ever sees them. Set redact_secrets
# to false to disable (e.g. when developing the redactor itself).
# tirith pre-exec scanning is enabled by default when the tirith binary
# is available. Configure via security.tirith_* keys or env vars
# (TIRITH_ENABLED, TIRITH_BIN, TIRITH_TIMEOUT, TIRITH_FAIL_OPEN).
#
# security:
#   redact_secrets: true
#   tirith_enabled: true
#   tirith_path: "tirith"
#   tirith_timeout: 5
#   tirith_fail_open: true

# ── Fallback Model ────────────────────────────────────────────────────
# Automatic provider failover when primary is unavailable.
# Uncomment and configure to enable. Triggers on rate limits (429),
# overload (529), service errors (503), or connection failures.
#
# Supported providers:
#   openrouter   (OPENROUTER_API_KEY)  — routes to any model
#   openai-codex (OAuth — hermes auth) — OpenAI Codex
#   nous         (OAuth — hermes auth) — Nous Portal
#   zai          (ZAI_API_KEY)         — Z.AI / GLM
#   kimi-coding  (KIMI_API_KEY)        — Kimi / Moonshot
#   kimi-coding-cn (KIMI_CN_API_KEY)   — Kimi / Moonshot (China)
#   minimax      (MINIMAX_API_KEY)     — MiniMax
#   minimax-cn   (MINIMAX_CN_API_KEY)  — MiniMax (China)
#   bedrock      (AWS IAM / boto3)     — AWS Bedrock (Converse API)
#
# For custom OpenAI-compatible endpoints, add base_url and key_env.
#
# fallback_model:
#   provider: openrouter
#   model: anthropic/claude-sonnet-4
